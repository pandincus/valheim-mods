# Code style for every project in this repo. The .NET SDK's own analyzers
# enforce it; Directory.Build.props sets EnforceCodeStyleInBuild so it is
# checked at build time rather than only in an editor.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Take the SDK defaults wholesale rather than curating a house style. There is
# no long-standing hand-tuned style here to protect, so the community default
# is the one that needs no justifying and that a newcomer already knows.
dotnet_analyzer_diagnostic.category-Style.severity = warning

# Off, permanently. Unity calls Awake and OnDestroy by reflection, and Harmony
# calls Prefix/Postfix the same way, so this rule reports the most load-bearing
# methods in a BepInEx plugin as dead code. It flagged four such members and was
# wrong about all four.
dotnet_diagnostic.IDE0051.severity = none

# Two departures from the defaults, both about a run of guard clauses reading as
# a table. Aligned one-liners let you scan the conditions down the left and the
# results down the right; wrapping each in braces turns four scannable lines
# into twenty and loses that.
csharp_prefer_braces = when_multiline

# Same reason from the other side. IDE0046 rewrites a trailing guard clause plus
# its return as one long ternary, which reads worse than the two lines it
# replaces and breaks the shape of the block above it.
dotnet_diagnostic.IDE0046.severity = none

# Off, and this one took a second look to spot, because dotnet format quietly
# "fixed" it rather than leaving a warning for us to argue with. What it does is
# prefix a discard onto any call whose return value you ignore, so a report
# builder made of StringBuilder.AppendLine calls turns into twelve lines of
# "_ = sb.AppendLine(...)", and Dictionary.Remove needs one too. In a codebase
# where ignoring a return value hides a failure this rule genuinely helps. Here
# it fires on the places where discarding is exactly the right thing to do, and
# all it buys is noise.
dotnet_diagnostic.IDE0058.severity = none

# Everything below is scoped to the mod half, where UnityEngine types live. The
# Logic/ folders keep the defaults, because nothing in them is a Unity object.
[src/*/*.cs]

# Off, and this one would introduce a bug rather than noise. UnityEngine.Object
# overrides operator == so that a destroyed object compares equal to null, while
# ?. and ?? use plain reference equality and do not. So "x == null ? null : x.Y"
# and "x?.Y" are genuinely different for a Character or a GameObject, and the
# second one happily calls into a destroyed object. dotnet format applies this
# silently, which is exactly how it would get in.
dotnet_diagnostic.IDE0031.severity = none
dotnet_diagnostic.IDE0029.severity = none
dotnet_diagnostic.IDE0030.severity = none

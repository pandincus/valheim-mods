<Project>

  <!-- Machine-specific paths. Override any of these on the command line, e.g.
       dotnet build -p:ValheimDir="D:\Games\Valheim"  -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ValheimManaged>$(ValheimDir)\valheim_Data\Managed</ValheimManaged>

    <!-- Thunderstore Mod Manager keeps BepInEx inside a per-game profile rather
         than in the game folder, so both the reference DLLs and the deploy
         target live here. -->
    <BepInExProfile Condition="'$(BepInExProfile)' == ''">$(AppData)\Thunderstore Mod Manager\DataFolder\Valheim\profiles\Default</BepInExProfile>
    <BepInExCore>$(BepInExProfile)\BepInEx\core</BepInExCore>
    <BepInExPlugins>$(BepInExProfile)\BepInEx\plugins</BepInExPlugins>
  </PropertyGroup>

  <!-- We do not want the XML file; we want the check that producing it turns on.
       Without this, <see cref="..."/> links are never validated. Several of ours
       point at private Valheim members, which resolve only because the build
       publicizes assembly_valheim - so an Iron Gate rename would rot them
       silently. CS1591 stays off: the goal is crefs that resolve, not a doc
       comment demanded on every public member. Nothing extra ships either way,
       because package.ps1 names the files it zips. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Without this the style rules in .editorconfig only ever run in an
         editor, so they are advisory and drift back. Building is the thing
         everyone does, so that is where the check belongs. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>

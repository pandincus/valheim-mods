<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Off to match the mod, which targets net472 and does not enable it. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Unlike the other two mods there is no <Compile Include> of a Logic/ folder
    here, because there is no Logic/. Everything this mod does is a question put to
    Unity's physics engine about two colliders, and there is no decision in it that
    can be made without a Collider in hand. The one thing a test can still guard is
    the version number, which is written down in three places.
  -->

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Matches the mod project, which targets net472 and is not annotated. -->
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Overrides Directory.Build.props, which turns this on to get crefs
         validated. That check is meaningless here: this project is a partial
         compilation of the mod's source, so a cref to ModConfig or Recipe
         cannot resolve even though it is perfectly correct in the real
         assembly. Leaving it on would bury genuine rot under false positives. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The mod targets net472 and references Unity and BepInEx, so this project
    cannot reference it directly. Instead it compiles the mod's Logic/ folder,
    which holds the files that have no such dependencies. That constraint is the
    point: if anything under Logic/ ever acquires a Unity or BepInEx using, this
    project stops building, which is exactly the guard rail we want.

    The glob is deliberate, and so is the folder. Moving a file into Logic/ is
    the act of promising it stays free of game types - nothing gets swept in by
    living next to the patches.
  -->
  <ItemGroup>
    <Compile Include="../../src/FishQualityBonus/Logic/**/*.cs" LinkBase="Logic" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
